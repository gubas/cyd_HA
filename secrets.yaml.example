# =============================================================================
# ESPHome Secrets Template
# =============================================================================
# Copy this file to "secrets.yaml" and fill in your actual credentials.
# NEVER commit "secrets.yaml" to Git (already protected by .gitignore).
# =============================================================================

# Global Wi-Fi Credentials
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Home Assistant API Encryption Key (Base64 32-byte key)
# Generate with: openssl rand -base64 32
cyd_ha_api_encryption_key: "YOUR_API_ENCRYPTION_KEY"

# Over-The-Air (OTA) Update Password
cyd_ha_ota_password: "YOUR_STRONG_OTA_PASSWORD"

# Note: Fallback AP credentials (wifi_ap_ssid & wifi_ap_password) are defined in
# cyd_ha/substitutions.yaml to enable compile-time QR code generation.
